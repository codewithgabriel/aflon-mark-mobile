{
  "cli": {
    "version": ">= 18.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "http://localhost:3000",
        "EXPO_PUBLIC_API_SECRET": "supersecret_aflon_key_123"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://aflon-mark-backend.vercel.app",
        "EXPO_PUBLIC_API_SECRET": "supersecret_aflon_key_123"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://aflon-mark-backend.vercel.app",
        "EXPO_PUBLIC_API_SECRET": "supersecret_aflon_key_123"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
