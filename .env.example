# ============================================
# BACKEND URL CONFIGURATION
# ============================================

# For LOCAL TESTING:
# Option 1: Comment out EXPO_PUBLIC_BACKEND_URL to auto-detect your local IP
# Option 2: Set to your computer's local IP: http://192.168.1.100:3000

# For PRODUCTION:
# Set to your deployed backend URL
EXPO_PUBLIC_BACKEND_URL=https://aflon-mark-backend.vercel.app

# ============================================
# API SECRET KEY
# ============================================
# Must match API_SECRET_KEY in the backend .env
EXPO_PUBLIC_API_SECRET=supersecret_aflon_key_123

